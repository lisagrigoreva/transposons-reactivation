sampleData = read.csv2("/groups/nordborg/projects/ddm1_resilencing/10_metadata/tm3_96_plates_rnaseq.txt", sep="\t", header=T)
# Read number of reads
number_of_reads <- read.csv2("/groups/nordborg/projects/ddm1_resilencing/03_processing/003_umi_dedup/all_plates_96w/read_counts.txt", sep=" ", header=F)
colnames(number_of_reads) <- c("Sample", "Number_of_Reads")
number_of_reads$Number_of_Reads<- as.numeric(number_of_reads$Number_of_Reads)
filtered_data <- number_of_reads %>% filter(Number_of_Reads>=500000) %>% inner_join(sampleData,by=c("Sample"="Sample"))
filtered_data$Number_of_Reads<-NULL
sampleData <- filtered_data
#Reorder in alphabetic order
sampleData<- sampleData[order(sampleData$Sample),]
#Make rownames acession names
rownames(sampleData) <- sampleData$Sample
sampleData <- as.data.frame(sampleData)
sampleData <- na.omit(sampleData)
mart <- biomaRt::useMart(biomart = "plants_mart",
dataset = "athaliana_eg_gene",
host = 'plants.ensembl.org')
genes_all_thaliana <- read.table("/groups/nordborg/projects/genome_organization/01_data/tair10/all_genes_tair10.bed", header=F)
colnames(genes_all_thaliana) <- c("start", "stop", "name")
keys <-genes_all_thaliana$name
results <- getBM(attributes=c('ensembl_gene_id', 'ensembl_transcript_id', 'transcript_length', 'gene_biotype', 'external_gene_name'),
values=keys,
mart=mart)
results <- results %>% dplyr::select(ensembl_gene_id,ensembl_transcript_id)
names(results) <- NULL
tx2gene <- results
#Annotation of TEs
library(rtracklayer)
tes_annotation <- readGFF("/groups/nordborg/projects/ddm1_resilencing/11_resources/ref_genome/Araport11_GFF3_genes_transposons.only.gff")
rsem_dir <- "/groups/nordborg/projects/ddm1_resilencing/03_processing/005_quant/all_plates_96w"
# List all the .genes.results files
files <- list.files(rsem_dir, pattern = "*.genes.results$", full.names = TRUE)
# Extract the sample IDs from the filenames (remove '_SXXX.genes.results')
fileSampleIDs <- basename(files) %>%
str_replace("_S\\d+\\.genes\\.results$", "")  # Remove '_SXXX.genes.results'
# Filter the files to include only those that match the sample IDs in sampleData
filteredFiles <- files[fileSampleIDs %in% sampleData$Sample]
# Create a named vector of filtered files for tximport
names(filteredFiles) <- fileSampleIDs[fileSampleIDs %in% sampleData$Sample]
# Filter sampleData to only include the samples for which you have RSEM files
filteredSampleData <- sampleData[sampleData$Sample %in% fileSampleIDs, ]
# Ensure that the rownames of filteredSampleData match the sample IDs
rownames(filteredSampleData) <- filteredSampleData$Sample
txi.rsem <- tximport(filteredFiles, type = "rsem", txIn = FALSE, txOut = FALSE,tx2gene=tx2gene)
# Reorder
filteredSampleData <- filteredSampleData[match(colnames(txi.rsem$counts), rownames(filteredSampleData)), ]
summary(colnames(txi.rsem$counts)==rownames(filteredSampleData))
#any(rowSums(txi.rsem$length) == 0)
#any(is.na(txi.rsem$length))
# Replace zeros and in the length matrix with 1
txi.rsem$abundance <- txi.rsem$abundance[apply(txi.rsem$length,1, function(row) all(row !=0 )),]
txi.rsem$counts <- txi.rsem$counts[apply(txi.rsem$length,1,function(row) all(row !=0 )),]
txi.rsem$length <-txi.rsem$length[apply(txi.rsem$length, 1,  function(row) all(row !=0 ))]
# Make a matrix out of the object
txi.rsem$length <- matrix(txi.rsem$length,
nrow = nrow(txi.rsem$counts),
ncol = ncol(txi.rsem$counts),
dimnames = dimnames(txi.rsem$counts))
# Make condition column variant
filteredSampleData$Variant <-as.factor(filteredSampleData$Variant)
filteredSampleData$Variant <-as.factor(filteredSampleData$Variant)
# Make sample as factor
filteredSampleData$Sample <-as.factor(filteredSampleData$Sample)
head(filteredSampleData)
unique(filteredSampleData$Genotype)
unique(filteredSampleData$Variant)
filteredSampleData$Genotype <-as.factor(filteredSampleData$Genotype)
dds = DESeqDataSetFromTximport(txi.rsem, colData = filteredSampleData, design = ~ Genotype) #Difference in treatment taking into account accession
dds$Genotype <- relevel( dds$Genotype, "ct_col" ) # Make sure that Col is the first (base) level
#dds <- dds[rowSums(counts(dds)) > 5, ] #Keep only counts more than 10
#dds <- dds[, colSums(counts(dds)) > 5] #Keep only sample if it has more than 5 counts
#Run DeSeq2
dds <- DESeq(dds)
